# Copy this file to .env.local and fill in your real MongoDB connection string.
# .env.local is gitignored and never committed.
#
# Get this from whoever manages the IIT Indore server's MongoDB instance,
# or from MongoDB Atlas if you're hosting the database there instead.
# Open the SAME connection string in MongoDB Compass to browse/export
# registrations any time.
MONGODB_URI=mongodb://localhost:27017/malwa_chemical_conclave
